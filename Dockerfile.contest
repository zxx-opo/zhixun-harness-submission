ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS build
WORKDIR /build
COPY requirements-contest.lock .
COPY docker/wheels/numpy-*.whl docker/wheels/setuptools-*.whl /wheels/
COPY docker/v17-training-wheels/*.whl /wheels/
COPY vendor/contest-harness-sdk-1.0.4 /sdk
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-index --find-links /wheels setuptools==84.2.1 -r requirements-contest.lock \
    && /opt/venv/bin/pip install --no-index --no-deps --no-build-isolation /sdk

FROM ${PYTHON_IMAGE}
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    BASELINE_CPU_THREADS=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY vendor/contest-harness-sdk-1.0.4/template/harness.py /app/harness.py
COPY vendor/reference/A/baselines/model.py vendor/reference/A/baselines/data.py /app/contest_engine/reference/
COPY contest_engine /app/contest_engine
COPY contest_submission.py /app/contest_submission.py
RUN mkdir -p /workspace /previous /model /data /state && chown 65534:65534 /workspace
USER 65534:65534
ENTRYPOINT ["python3", "/app/harness.py"]
